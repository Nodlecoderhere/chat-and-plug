# ======================================================
# PLUG & CHAT ENVIRONMENT VARIABLES
# ======================================================

# Supabase Project URL (Obtain from Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Publishable / Anon Key (Public key safe for browser use)
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Alternative variable name supported:
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
